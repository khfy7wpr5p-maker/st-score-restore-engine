        "private_by_default",
        "least_privilege_access",
        "separation_of_duties",
        "quarantine_isolation",
        "audit_integrity_and_anti_rollback",
        "retention_enforcement",
        "immediate_revocation",
        "deletion_receipts",
        "backup_anti_resurrection",
