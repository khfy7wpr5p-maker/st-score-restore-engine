{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://st-score-restore.example/schemas/dataset-snapshot.schema.json",
  "title": "ST Score Restore Stage 1A Dataset Snapshot",
  "description": "Digest-bound split snapshot contract. Stage 1A forbids training activation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "datasetId",
    "version",
    "createdAt",
    "catalogSha256",
    "assignments",
    "heldOutFrozen",
    "trainingUseActivated",
    "revokedItemIds",
    "coverage",
    "review"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "snapshotId": {"$ref": "#/$defs/id"},
    "datasetId": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "catalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datasetItemId", "sourceFamilyId", "split", "itemSha256"],
        "properties": {
          "datasetItemId": {"$ref": "#/$defs/id"},
          "sourceFamilyId": {"$ref": "#/$defs/id"},
          "split": {"enum": ["development", "calibration", "held_out", "training_reserved"]},
          "itemSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "heldOutFrozen": {"type": "boolean"},
    "trainingUseActivated": {"const": false},
    "revokedItemIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realItemCount", "syntheticItemCount", "gapNotes"],
      "properties": {
        "realItemCount": {"type": "integer", "minimum": 0},
        "syntheticItemCount": {"type": "integer", "minimum": 0},
        "gapNotes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedBy", "reviewedOn", "notes"],
      "properties": {
        "status": {"const": "approved"},
        "reviewedBy": {"type": "string", "minLength": 1},
        "reviewedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"}
  }
}
