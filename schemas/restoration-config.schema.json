{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://st-score-restore.example/schemas/restoration-config.schema.json",
  "title": "ST Score Restore deterministic OpenCV configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "orientation_enabled": {"type": "boolean"},
    "deskew_enabled": {"type": "boolean"},
    "perspective_enabled": {"type": "boolean"},
    "crop_enabled": {"type": "boolean"},
    "illumination_enabled": {"type": "boolean"},
    "denoise_enabled": {"type": "boolean"},
    "contrast_enabled": {"type": "boolean"},
    "binarization_profile": {"enum": ["none", "otsu", "adaptive"]},
    "max_deskew_degrees": {"type": "number", "minimum": 0, "maximum": 15},
    "min_deskew_degrees": {"type": "number", "minimum": 0, "maximum": 15},
    "deskew_min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "perspective_min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "min_page_area_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "max_page_area_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "illumination_kernel_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
    "illumination_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "denoise_kernel": {"enum": [1, 3, 5]},
    "clahe_clip_limit": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
    "clahe_grid_size": {"type": "integer", "minimum": 2, "maximum": 32},
    "protected_dark_threshold": {"type": "integer", "minimum": 0, "maximum": 255},
    "protected_dilation": {"enum": [0, 1, 2]},
    "max_protected_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "jpeg_quality": {"type": "integer", "minimum": 80, "maximum": 100},
    "output_dpi": {"type": "integer", "minimum": 72, "maximum": 1200},
    "max_decode_pixels": {"type": "integer", "minimum": 1, "maximum": 200000000}
  }
}
