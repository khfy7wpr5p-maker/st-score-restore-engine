{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://st-score-restore.invalid/schemas/stage1c-vault-verification.schema.json",
  "title": "ST Score Restore Stage 1C Vault Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractRef",
    "g4BindingRef",
    "verificationId",
    "vaultRef",
    "assessorRef",
    "assessedAt",
    "environment",
    "storageClass",
    "overallState",
    "controls",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": "stage1c-vault-verification-v1"
    },
    "contractRef": {
      "const": "adr-0014-stage-1b-custody-operations-v1"
    },
    "g4BindingRef": {
      "const": "stage1c-g4-2026-08-08"
    },
    "verificationId": {
      "type": "string",
      "pattern": "^vaultver:opq_[A-Za-z0-9_-]{16,64}$"
    },
    "vaultRef": {
      "type": "string",
      "pattern": "^custody:opq_[A-Za-z0-9_-]{16,64}$"
    },
    "assessorRef": {
      "type": "string",
      "pattern": "^actor:opq_[A-Za-z0-9_-]{16,64}$"
    },
    "assessedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "const": "stage1_offline"
    },
    "storageClass": {
      "const": "custody_external"
    },
    "overallState": {
      "enum": ["pass", "fail", "incomplete"]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_host",
        "encryption_at_rest",
        "offline_boundary",
        "private_by_default",
        "least_privilege_access",
        "separation_of_duties",
        "quarantine_isolation",
        "audit_integrity_and_anti_rollback",
        "retention_enforcement",
        "immediate_revocation",
        "deletion_receipts",
        "backup_anti_resurrection",
        "git_and_sync_separation"
      ],
      "properties": {
        "supported_host": {"$ref": "#/$defs/controlEvidence"},
        "encryption_at_rest": {"$ref": "#/$defs/controlEvidence"},
        "offline_boundary": {"$ref": "#/$defs/controlEvidence"},
        "private_by_default": {"$ref": "#/$defs/controlEvidence"},
        "least_privilege_access": {"$ref": "#/$defs/controlEvidence"},
        "separation_of_duties": {"$ref": "#/$defs/controlEvidence"},
        "quarantine_isolation": {"$ref": "#/$defs/controlEvidence"},
        "audit_integrity_and_anti_rollback": {"$ref": "#/$defs/controlEvidence"},
        "retention_enforcement": {"$ref": "#/$defs/controlEvidence"},
        "immediate_revocation": {"$ref": "#/$defs/controlEvidence"},
        "deletion_receipts": {"$ref": "#/$defs/controlEvidence"},
        "backup_anti_resurrection": {"$ref": "#/$defs/controlEvidence"},
        "git_and_sync_separation": {"$ref": "#/$defs/controlEvidence"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactOnboardingAuthorized",
        "artifactPermissionGranted",
        "artifactBytesIncluded",
        "realArtifactDigestIncluded",
        "stage2Authorized"
      ],
      "properties": {
        "artifactOnboardingAuthorized": {"const": false},
        "artifactPermissionGranted": {"const": false},
        "artifactBytesIncluded": {"const": false},
        "realArtifactDigestIncluded": {"const": false},
        "stage2Authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "controlEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidenceRef"],
      "properties": {
        "result": {
          "enum": ["pass", "fail", "not_verified"]
        },
        "evidenceRef": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^evidence:opq_[A-Za-z0-9_-]{16,64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
